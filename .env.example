# Copy to /etc/wazuh-llm-triage.env and fill in real values.
# Never commit the real file.

# Wazuh
ALERT_FILE=/var/ossec/logs/alerts/alerts.json
MIN_LEVEL=11
AGGREGATION_WINDOW=30

# LLM: any OpenAI-compatible endpoint
# vLLM:   http://YOUR-LLM-HOST:8000/v1/chat/completions
# Ollama: http://YOUR-LLM-HOST:11434/v1/chat/completions
LLM_URL=http://localhost:8000/v1/chat/completions
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
LLM_API_KEY=
LLM_TIMEOUT=120

# Set to false to stop sending source IPs to ipinfo.io
GEOIP_ENABLED=true

# Email
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
EMAIL_USER=alerts@example.com
EMAIL_PASS=YOUR_SMTP_PASSWORD
EMAIL_TO=soc-team@example.com,analyst@example.com

# Logging
LOG_FILE=/var/log/wazuh-llm-triage/wazuh-llm-triage.log
